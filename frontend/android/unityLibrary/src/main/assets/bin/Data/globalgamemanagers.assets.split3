    u_xlatu5.xy = u_xlatu4.zw;
    u_xlatu5.zw = gl_WorkGroupID.zz;
    u_xlat9 = imageLoad(_DepthMipChain, ivec3(u_xlatu5.xyz)).x;
    u_xlatu4.zw = gl_WorkGroupID.zz;
    u_xlat15 = imageLoad(_DepthMipChain, ivec3(u_xlatu4.xyz)).x;
