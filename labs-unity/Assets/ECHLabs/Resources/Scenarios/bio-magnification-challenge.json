{
  "id": "bio-magnification-challenge",
  "version": 2,
  "title": "Expert Challenge: Measuring Cells",
  "summary": "No hints. Calculate magnification and real cell sizes at two different powers.",
  "subject": "biology",
  "level": "secondary",
  "environment": "BioLab",
  "difficulty": 5,
  "tags": [
    "microscopy",
    "exam practice"
  ],
  "durationMin": 30,
  "objectives": [
    "Use I = A × M fluently",
    "Convert between mm and µm"
  ],
  "equipment": [
    {
      "id": "scope",
      "type": "microscope",
      "slot": "scope.station",
      "init": {
        "commands": [
          "4x",
          "10x",
          "40x"
        ]
      }
    },
    {
      "id": "slide1",
      "type": "slide",
      "slot": "prep.station",
      "label": "Onion epidermis",
      "init": {
        "specimen": "onion"
      }
    },
    {
      "id": "stain1",
      "type": "stain",
      "slot": "benchA.center",
      "label": "Iodine solution",
      "init": {
        "name": "iodine"
      }
    }
  ],
  "variables": {
    "mic": {
      "model": "bio.microscope",
      "inputs": {
        "microscope": "scope"
      },
      "params": {
        "idealFocus": 0.62
      }
    }
  },
  "steps": [
    {
      "id": "stain",
      "kind": "action",
      "title": "Stain the specimen",
      "instruction": "Add iodine to the onion skin on the slide.",
      "expect": {
        "intent": "Pour",
        "target": "stain1",
        "into": "slide1"
      },
      "focus": "stain1",
      "points": 10,
      "hints": [],
      "until": "slide1.stained"
    },
    {
      "id": "cover",
      "kind": "action",
      "title": "Coverslip",
      "instruction": "Lower a coverslip onto the slide.",
      "expect": {
        "intent": "Select",
        "target": "slide1"
      },
      "focus": "slide1",
      "points": 10,
      "hints": [],
      "until": "slide1.coverslip"
    },
    {
      "id": "stage",
      "kind": "action",
      "title": "Load the slide",
      "instruction": "Place the slide on the microscope stage.",
      "expect": {
        "intent": "Grab",
        "target": "slide1",
        "into": "scope"
      },
      "focus": "slide1",
      "points": 10,
      "hints": [],
      "until": "scope.slideLoaded"
    },
    {
      "id": "light",
      "kind": "action",
      "title": "Light",
      "instruction": "Switch on the microscope light.",
      "expect": {
        "intent": "Toggle",
        "target": "scope"
      },
      "focus": "scope",
      "points": 10,
      "hints": [],
      "until": "scope.lightOn"
    },
    {
      "id": "focus",
      "kind": "action",
      "title": "Focus",
      "instruction": "Focus the image with the fine focus knob.",
      "expect": {
        "intent": "Rotate",
        "target": "scope",
        "value": {
          "min": 0.6,
          "max": 0.64
        }
      },
      "focus": "scope",
      "points": 10,
      "hints": [],
      "until": "mic.focusQuality >= 0.8"
    },
    {
      "id": "mag10",
      "kind": "action",
      "title": "Medium power",
      "instruction": "Switch to 10×.",
      "expect": {
        "intent": "Type",
        "target": "scope"
      },
      "focus": "scope",
      "points": 10,
      "hints": [],
      "until": "scope.lastCommand == '10x'"
    },
    {
      "id": "focus10",
      "kind": "action",
      "title": "Refocus",
      "instruction": "Refocus.",
      "expect": {
        "intent": "Rotate",
        "target": "scope",
        "value": {
          "min": 0.6,
          "max": 0.64
        }
      },
      "focus": "scope",
      "points": 10,
      "hints": [],
      "until": "mic.focusQuality >= 0.8 && scope.objective == 10"
    },
    {
      "id": "size10",
      "kind": "measure",
      "title": "Measure",
      "instruction": "A cell image is 25 mm long at this power. Real length in µm?",
      "record": {
        "key": "size10",
        "label": "Real length at 100×",
        "unit": "µm",
        "truth": "25 * 1000 / mic.magnification",
        "tolerance": 1
      },
      "points": 10,
      "hints": []
    },
    {
      "id": "mag40",
      "kind": "action",
      "title": "High power",
      "instruction": "Switch to 40×.",
      "expect": {
        "intent": "Type",
        "target": "scope"
      },
      "focus": "scope",
      "points": 10,
      "hints": [],
      "until": "scope.lastCommand == '40x'"
    },
    {
      "id": "focus40",
      "kind": "action",
      "title": "Refocus",
      "instruction": "Refocus.",
      "expect": {
        "intent": "Rotate",
        "target": "scope",
        "value": {
          "min": 0.61,
          "max": 0.63
        }
      },
      "focus": "scope",
      "points": 10,
      "hints": [],
      "until": "mic.focusQuality >= 0.8 && scope.objective == 40"
    },
    {
      "id": "img40",
      "kind": "measure",
      "title": "Predict",
      "instruction": "How long (mm) will the same cell look at this power?",
      "record": {
        "key": "img40",
        "label": "Image length at 400×",
        "unit": "mm",
        "truth": "250 * mic.magnification / 1000",
        "tolerance": 1
      },
      "points": 10,
      "hints": []
    }
  ],
  "hazards": [],
  "results": [
    {
      "key": "size10",
      "label": "Real length",
      "unit": "µm",
      "expected": 250,
      "tolerancePct": 2,
      "source": "record.size10"
    },
    {
      "key": "img40",
      "label": "Image at 400×",
      "unit": "mm",
      "expected": 100,
      "tolerancePct": 2,
      "source": "record.img40"
    }
  ],
  "scoring": {
    "accuracy": 60,
    "procedure": 40,
    "safety": 0
  },
  "passScore": 60,
  "xp": 190
}
