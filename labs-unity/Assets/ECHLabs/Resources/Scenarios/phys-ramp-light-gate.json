{
  "version": 1,
  "level": "secondary",
  "variables": {},
  "id": "phys-ramp-light-gate",
  "title": "Speed Down a Ramp (Light Gate)",
  "difficulty": 3,
  "durationMin": 15,
  "xp": 120,
  "environment": "PhysicsLab",
  "subject": "physics",
  "summary": "Roll a trolley down a ramp at two angles and measure its speed with a light gate. How does the angle change the speed?",
  "tags": [
    "motion",
    "light gates",
    "practice"
  ],
  "objectives": [
    "Use a light gate to measure speed",
    "Change one variable at a time",
    "Relate angle to acceleration"
  ],
  "equipment": [
    {
      "id": "ramp1",
      "type": "ramp",
      "slot": "benchA.center",
      "init": {
        "lengthM": 1,
        "frictionCoeff": 0.04,
        "trolleyMassKg": 0.5
      }
    },
    {
      "id": "gate",
      "type": "light_gate",
      "slot": "benchA.right"
    }
  ],
  "steps": [
    {
      "id": "gate",
      "kind": "action",
      "title": "Set up",
      "instruction": "Set up the light gate at the bottom of the ramp.",
      "expect": {
        "intent": "Connect",
        "target": "gate",
        "into": "ramp1"
      },
      "focus": "gate",
      "points": 10,
      "hints": [],
      "until": "gate.connected"
    },
    {
      "id": "a10",
      "kind": "action",
      "title": "Run 1",
      "instruction": "Raise the ramp to 10°.",
      "expect": {
        "intent": "Rotate",
        "target": "ramp1",
        "value": {
          "min": 9.5,
          "max": 10.5
        }
      },
      "focus": "ramp1",
      "points": 10,
      "hints": [],
      "until": "between(ramp1.angleDeg, 9.5, 10.5)"
    },
    {
      "id": "go1",
      "kind": "action",
      "title": "Run 1",
      "instruction": "Let the trolley go from the top.",
      "expect": {
        "intent": "Release",
        "target": "ramp1"
      },
      "focus": "ramp1",
      "points": 10,
      "hints": [],
      "until": "ramp1.atBottom"
    },
    {
      "id": "v1",
      "kind": "measure",
      "title": "Run 1",
      "instruction": "Read the speed shown by the light gate.",
      "record": {
        "unit": "m/s",
        "key": "v10",
        "label": "Speed at 10°",
        "truth": "gate.reading",
        "tolerance": 0.005
      },
      "points": 10,
      "hints": [],
      "focus": "gate"
    },
    {
      "id": "back",
      "kind": "action",
      "title": "Reset",
      "instruction": "Put the trolley back at the top.",
      "expect": {
        "intent": "Grab",
        "target": "ramp1"
      },
      "focus": "ramp1",
      "points": 5,
      "hints": [],
      "until": "!ramp1.atBottom && !ramp1.running"
    },
    {
      "id": "a20",
      "kind": "action",
      "title": "Run 2",
      "instruction": "Raise the ramp to 20°.",
      "expect": {
        "intent": "Rotate",
        "target": "ramp1",
        "value": {
          "min": 19.5,
          "max": 20.5
        }
      },
      "focus": "ramp1",
      "points": 10,
      "hints": [],
      "until": "between(ramp1.angleDeg, 19.5, 20.5)"
    },
    {
      "id": "go2",
      "kind": "action",
      "title": "Run 2",
      "instruction": "Let the trolley go again.",
      "expect": {
        "intent": "Release",
        "target": "ramp1"
      },
      "focus": "ramp1",
      "points": 10,
      "hints": [],
      "until": "ramp1.atBottom"
    },
    {
      "id": "v2",
      "kind": "measure",
      "title": "Run 2",
      "instruction": "Read the new speed.",
      "record": {
        "unit": "m/s",
        "key": "v20",
        "label": "Speed at 20°",
        "truth": "gate.reading",
        "tolerance": 0.005
      },
      "points": 10,
      "hints": [],
      "focus": "gate"
    },
    {
      "id": "q1",
      "kind": "checkpoint",
      "title": "Check your understanding",
      "instruction": "Answer the question.",
      "checkpoint": {
        "question": {
          "prompt": "Why was the trolley faster at 20°?",
          "choices": [
            "A bigger part of its weight acts down the slope, so it accelerates more",
            "It is lighter on a steep slope",
            "Friction is bigger",
            "The light gate is closer"
          ],
          "answerIndex": 0,
          "explanation": "The force down the slope is mg sin θ, which grows with the angle."
        }
      },
      "points": 10,
      "hints": []
    },
    {
      "id": "q2",
      "kind": "checkpoint",
      "title": "Check your understanding",
      "instruction": "Answer the question.",
      "checkpoint": {
        "question": {
          "prompt": "Why use a light gate instead of a stopwatch?",
          "choices": [
            "It removes human reaction time",
            "It is cheaper",
            "It weighs the trolley",
            "It slows the trolley down"
          ],
          "answerIndex": 0,
          "explanation": "Light gates time automatically to a thousandth of a second."
        }
      },
      "points": 10,
      "hints": []
    }
  ],
  "hazards": [],
  "results": [],
  "scoring": {
    "accuracy": 0,
    "procedure": 100,
    "safety": 0
  }
}
