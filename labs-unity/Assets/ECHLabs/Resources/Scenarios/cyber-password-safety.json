{
  "id": "cyber-password-safety",
  "version": 2,
  "title": "Strong Passwords & MFA",
  "summary": "Test passwords against a cracking tool and set up multi-factor authentication for a teacher account.",
  "subject": "cybersecurity",
  "level": "secondary",
  "environment": "CyberSOC",
  "difficulty": 2,
  "tags": [
    "passwords",
    "MFA"
  ],
  "durationMin": 15,
  "objectives": [
    "Recognise weak passwords",
    "Explain why MFA helps"
  ],
  "equipment": [
    {
      "id": "ws",
      "type": "workstation",
      "slot": "desk.main",
      "label": "Analyst workstation",
      "init": {
        "os": "ECH-SOC Linux",
        "commands": [
          "test password 123456",
          "test password Kigali2024",
          "test password correct-horse-battery-staple",
          "enable mfa teacher01"
        ]
      }
    }
  ],
  "variables": {},
  "steps": [
    {
      "id": "t1",
      "kind": "action",
      "title": "Test a password",
      "instruction": "Test the password \"123456\".",
      "expect": {
        "intent": "Type",
        "target": "ws"
      },
      "focus": "ws",
      "points": 10,
      "hints": [
        "Run the first test command."
      ],
      "until": "ws.lastCommand == 'test password 123456'",
      "say": "Result: cracked in less than 1 second — it is the most common password in the world."
    },
    {
      "id": "t2",
      "kind": "action",
      "title": "Test a password",
      "instruction": "Test \"Kigali2024\".",
      "expect": {
        "intent": "Type",
        "target": "ws"
      },
      "focus": "ws",
      "points": 10,
      "hints": [],
      "until": "ws.lastCommand == 'test password Kigali2024'",
      "say": "Result: cracked in about 3 hours — a place plus a year is easy to guess."
    },
    {
      "id": "t3",
      "kind": "action",
      "title": "Test a passphrase",
      "instruction": "Test the passphrase \"correct-horse-battery-staple\".",
      "expect": {
        "intent": "Type",
        "target": "ws"
      },
      "focus": "ws",
      "points": 10,
      "hints": [],
      "until": "ws.lastCommand == 'test password correct-horse-battery-staple'",
      "say": "Result: centuries to crack — long passphrases are strong AND easy to remember."
    },
    {
      "id": "q1",
      "kind": "checkpoint",
      "title": "Check your understanding",
      "instruction": "Answer the question.",
      "checkpoint": {
        "question": {
          "prompt": "Which makes a password strongest?",
          "choices": [
            "Length — a long passphrase",
            "Replacing a with @",
            "Adding the year",
            "Using your pet's name"
          ],
          "answerIndex": 0,
          "explanation": "Every extra character multiplies the number of guesses needed."
        }
      },
      "points": 10,
      "hints": []
    },
    {
      "id": "mfa",
      "kind": "action",
      "title": "Multi-factor authentication",
      "instruction": "Enable MFA on the teacher01 account.",
      "expect": {
        "intent": "Type",
        "target": "ws"
      },
      "focus": "ws",
      "points": 10,
      "hints": [
        "Run \"enable mfa teacher01\"."
      ],
      "until": "ws.lastCommand == 'enable mfa teacher01'"
    },
    {
      "id": "q2",
      "kind": "checkpoint",
      "title": "Check your understanding",
      "instruction": "Answer the question.",
      "checkpoint": {
        "question": {
          "prompt": "A hacker steals a password but the account has MFA. What happens?",
          "choices": [
            "They still need the second factor (e.g. the phone code)",
            "They get in anyway",
            "The account is deleted",
            "The password changes itself"
          ],
          "answerIndex": 0,
          "explanation": "MFA means a stolen password alone is not enough."
        }
      },
      "points": 10,
      "hints": []
    }
  ],
  "hazards": [],
  "results": [],
  "scoring": {
    "accuracy": 0,
    "procedure": 80,
    "safety": 20
  },
  "passScore": 60,
  "xp": 100
}
