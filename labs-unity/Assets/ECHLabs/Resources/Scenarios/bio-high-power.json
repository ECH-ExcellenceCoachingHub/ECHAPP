{
  "id": "bio-high-power",
  "version": 2,
  "title": "High-Power Microscopy (400×)",
  "summary": "Move from low power to 400× without losing your specimen — the skill every biologist needs.",
  "subject": "biology",
  "level": "secondary",
  "environment": "BioLab",
  "difficulty": 4,
  "tags": [
    "microscopy",
    "magnification"
  ],
  "durationMin": 25,
  "objectives": [
    "Change objectives in the correct order",
    "Use only fine focus at high power",
    "Calculate magnification"
  ],
  "equipment": [
    {
      "id": "scope",
      "type": "microscope",
      "slot": "scope.station",
      "init": {
        "commands": [
          "4x",
          "10x",
          "40x"
        ]
      }
    },
    {
      "id": "slide1",
      "type": "slide",
      "slot": "prep.station",
      "label": "Onion epidermis",
      "init": {
        "specimen": "onion"
      }
    },
    {
      "id": "stain1",
      "type": "stain",
      "slot": "benchA.center",
      "label": "Iodine solution",
      "init": {
        "name": "iodine"
      }
    }
  ],
  "variables": {
    "mic": {
      "model": "bio.microscope",
      "inputs": {
        "microscope": "scope"
      },
      "params": {
        "idealFocus": 0.62
      }
    }
  },
  "steps": [
    {
      "id": "stain",
      "kind": "action",
      "title": "Stain the specimen",
      "instruction": "Add iodine to the onion skin on the slide.",
      "expect": {
        "intent": "Pour",
        "target": "stain1",
        "into": "slide1"
      },
      "focus": "stain1",
      "points": 10,
      "hints": [
        "Select the stain dropper, \"Pour\", then select the slide."
      ],
      "until": "slide1.stained"
    },
    {
      "id": "cover",
      "kind": "action",
      "title": "Coverslip",
      "instruction": "Lower a coverslip onto the slide.",
      "expect": {
        "intent": "Select",
        "target": "slide1"
      },
      "focus": "slide1",
      "points": 10,
      "hints": [
        "Select the stained slide to add the coverslip.",
        "Lower it at an angle to avoid air bubbles."
      ],
      "until": "slide1.coverslip"
    },
    {
      "id": "stage",
      "kind": "action",
      "title": "Load the slide",
      "instruction": "Place the slide on the microscope stage.",
      "expect": {
        "intent": "Grab",
        "target": "slide1",
        "into": "scope"
      },
      "focus": "slide1",
      "points": 10,
      "hints": [
        "Pick up the slide, then select the microscope."
      ],
      "until": "scope.slideLoaded"
    },
    {
      "id": "light",
      "kind": "action",
      "title": "Light",
      "instruction": "Switch on the microscope light.",
      "expect": {
        "intent": "Toggle",
        "target": "scope"
      },
      "focus": "scope",
      "points": 10,
      "hints": [
        "Choose \"Light on\"."
      ],
      "until": "scope.lightOn"
    },
    {
      "id": "focus",
      "kind": "action",
      "title": "Focus",
      "instruction": "Focus the image with the fine focus knob.",
      "expect": {
        "intent": "Rotate",
        "target": "scope",
        "value": {
          "min": 0.6,
          "max": 0.64
        }
      },
      "focus": "scope",
      "points": 10,
      "hints": [
        "Choose \"Focus\" and move the slider slowly until the image is sharp (around 62%)."
      ],
      "until": "mic.focusQuality >= 0.8"
    },
    {
      "id": "mag10",
      "kind": "action",
      "title": "Medium power",
      "instruction": "Switch to 10×.",
      "expect": {
        "intent": "Type",
        "target": "scope"
      },
      "focus": "scope",
      "points": 10,
      "hints": [
        "Always go 4× → 10× → 40× in order."
      ],
      "until": "scope.lastCommand == '10x'"
    },
    {
      "id": "focus10",
      "kind": "action",
      "title": "Refocus",
      "instruction": "Refocus at 10×.",
      "expect": {
        "intent": "Rotate",
        "target": "scope",
        "value": {
          "min": 0.6,
          "max": 0.64
        }
      },
      "focus": "scope",
      "points": 10,
      "hints": [],
      "until": "mic.focusQuality >= 0.8 && scope.objective == 10"
    },
    {
      "id": "mag40",
      "kind": "action",
      "title": "High power",
      "instruction": "Switch to 40×.",
      "expect": {
        "intent": "Type",
        "target": "scope"
      },
      "focus": "scope",
      "points": 10,
      "hints": [],
      "until": "scope.lastCommand == '40x'"
    },
    {
      "id": "focus40",
      "kind": "action",
      "title": "Refocus",
      "instruction": "Refocus at 40× — depth of field is very small now.",
      "expect": {
        "intent": "Rotate",
        "target": "scope",
        "value": {
          "min": 0.61,
          "max": 0.63
        }
      },
      "focus": "scope",
      "points": 10,
      "hints": [
        "Tiny movements only."
      ],
      "until": "mic.focusQuality >= 0.8 && scope.objective == 40"
    },
    {
      "id": "mag",
      "kind": "measure",
      "title": "Magnification",
      "instruction": "Record the total magnification.",
      "record": {
        "key": "mag",
        "label": "Total magnification",
        "unit": "×",
        "truth": "mic.magnification",
        "tolerance": 0
      },
      "points": 10,
      "hints": []
    },
    {
      "id": "size",
      "kind": "measure",
      "title": "Real size",
      "instruction": "A cell looks 8 mm long at this magnification. What is its real length in micrometres (µm)? (1 mm = 1000 µm)",
      "record": {
        "key": "size",
        "label": "Real cell length",
        "unit": "µm",
        "truth": "8 * 1000 / mic.magnification",
        "tolerance": 0.5
      },
      "points": 10,
      "hints": [
        "Real size = image size ÷ magnification."
      ]
    }
  ],
  "hazards": [],
  "results": [
    {
      "key": "mag",
      "label": "Magnification",
      "unit": "×",
      "expected": 400,
      "tolerancePct": 1,
      "source": "record.mag"
    },
    {
      "key": "size",
      "label": "Real cell length",
      "unit": "µm",
      "expected": 20,
      "tolerancePct": 3,
      "source": "record.size"
    }
  ],
  "scoring": {
    "accuracy": 50,
    "procedure": 50,
    "safety": 0
  },
  "passScore": 60,
  "xp": 160
}
