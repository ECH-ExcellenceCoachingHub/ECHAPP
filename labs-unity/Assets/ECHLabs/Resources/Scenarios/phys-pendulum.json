{
  "id": "phys-pendulum",
  "version": 2,
  "title": "The Simple Pendulum: Measuring g",
  "summary": "Time 20 oscillations of a pendulum, find its period and use T = 2π√(L/g) to calculate the acceleration due to gravity.",
  "subject": "physics",
  "level": "secondary",
  "environment": "PhysicsLab",
  "durationMin": 15,
  "objectives": [
    "Measure the length of a pendulum accurately",
    "Reduce timing errors by timing many oscillations",
    "Calculate g from the period"
  ],
  "equipment": [
    {
      "id": "pend",
      "type": "pendulum",
      "slot": "benchA.center",
      "init": {
        "lengthM": 0.8,
        "massKg": 0.05
      }
    },
    {
      "id": "watch",
      "type": "stopwatch",
      "slot": "benchB.center"
    },
    {
      "id": "rule",
      "type": "metre_rule",
      "slot": "benchA.right"
    }
  ],
  "variables": {
    "pm": {
      "model": "phys.pendulum",
      "inputs": {
        "pendulum": "pend"
      }
    }
  },
  "steps": [
    {
      "id": "measureL",
      "kind": "measure",
      "title": "Measure the length",
      "instruction": "Use the metre rule to measure the length from the pivot to the centre of the bob.",
      "say": "Measure to the centre of the bob: that is where the mass acts.",
      "record": {
        "key": "length",
        "label": "Length L",
        "unit": "m",
        "truth": "pend.lengthM",
        "tolerance": 0.005
      },
      "focus": "rule",
      "points": 15
    },
    {
      "id": "release",
      "kind": "action",
      "title": "Start the swing",
      "instruction": "Pull the bob aside by a small angle (less than 10°) and release it.",
      "expect": {
        "intent": "Release",
        "target": "pend"
      },
      "until": "pend.swinging && pend.amplitudeDeg <= 10",
      "focus": "pend",
      "points": 15,
      "hints": [
        "Small angles keep the formula T = 2π√(L/g) accurate."
      ]
    },
    {
      "id": "time20",
      "kind": "action",
      "title": "Time 20 oscillations",
      "instruction": "Start the stopwatch as the bob passes the centre, and stop it after 20 complete oscillations.",
      "expect": {
        "intent": "Toggle",
        "target": "watch"
      },
      "until": "pend.oscillations >= 20 && !watch.running",
      "focus": "pend",
      "points": 20
    },
    {
      "id": "period",
      "kind": "measure",
      "title": "Find the period",
      "instruction": "Divide your time by 20 to find the period T.",
      "record": {
        "key": "period",
        "label": "Period T",
        "unit": "s",
        "truth": "watch.elapsedS / 20",
        "tolerance": 0.02
      },
      "points": 15
    },
    {
      "id": "gcalc",
      "kind": "measure",
      "title": "Calculate g",
      "instruction": "Calculate g = 4π²L ÷ T².",
      "record": {
        "key": "g",
        "label": "Acceleration due to gravity g",
        "unit": "m/s²",
        "truth": "4 * 9.8696 * record.length / (record.period * record.period)",
        "tolerance": 0.1
      },
      "points": 20
    },
    {
      "id": "q1",
      "kind": "checkpoint",
      "title": "Check your understanding",
      "instruction": "Answer the question.",
      "checkpoint": {
        "question": {
          "prompt": "Why do we time 20 oscillations instead of just one?",
          "choices": [
            "It reduces the effect of reaction-time error on the period",
            "The pendulum speeds up after 20 swings",
            "It makes the amplitude bigger",
            "One oscillation cannot be timed"
          ],
          "answerIndex": 0,
          "explanation": "Your reaction-time error (≈0.2 s) is shared over 20 periods, so the error in T becomes about 20 times smaller."
        }
      },
      "points": 15
    }
  ],
  "hazards": [],
  "results": [
    {
      "key": "g",
      "label": "g",
      "unit": "m/s²",
      "expected": 9.81,
      "tolerancePct": 3,
      "source": "record.g"
    }
  ],
  "scoring": {
    "accuracy": 50,
    "procedure": 50,
    "safety": 0
  },
  "passScore": 60,
  "xp": 120,
  "difficulty": 3,
  "tags": [
    "mechanics"
  ]
}
