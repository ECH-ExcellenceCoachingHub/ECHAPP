{
  "id": "net-ip-addressing",
  "version": 2,
  "title": "IP Addresses & Subnet Masks",
  "summary": "Read and set IP addresses, and work out how many devices fit on a /24 network.",
  "subject": "networking",
  "level": "secondary",
  "environment": "ServerRoom",
  "difficulty": 2,
  "tags": [
    "IPv4",
    "subnets"
  ],
  "durationMin": 15,
  "objectives": [
    "Read an IPv4 address and mask",
    "Count usable hosts on a /24"
  ],
  "equipment": [
    {
      "id": "ws",
      "type": "workstation",
      "slot": "desk.main",
      "label": "Admin PC",
      "init": {
        "os": "ECH NetOS",
        "commands": [
          "ipconfig",
          "set ip 192.168.1.50/24",
          "set gateway 192.168.1.1",
          "ping 192.168.1.1"
        ]
      }
    }
  ],
  "variables": {},
  "steps": [
    {
      "id": "ipc",
      "kind": "action",
      "title": "Current settings",
      "instruction": "Show the PC's network settings.",
      "expect": {
        "intent": "Type",
        "target": "ws"
      },
      "focus": "ws",
      "points": 10,
      "hints": [
        "Run \"ipconfig\"."
      ],
      "until": "ws.lastCommand == 'ipconfig'"
    },
    {
      "id": "setip",
      "kind": "action",
      "title": "Configure",
      "instruction": "Give the PC the address 192.168.1.50 with a /24 mask.",
      "expect": {
        "intent": "Type",
        "target": "ws"
      },
      "focus": "ws",
      "points": 10,
      "hints": [
        "/24 means the mask 255.255.255.0."
      ],
      "until": "ws.lastCommand == 'set ip 192.168.1.50/24'"
    },
    {
      "id": "gw",
      "kind": "action",
      "title": "Configure",
      "instruction": "Set the default gateway (the router).",
      "expect": {
        "intent": "Type",
        "target": "ws"
      },
      "focus": "ws",
      "points": 10,
      "hints": [],
      "until": "ws.lastCommand == 'set gateway 192.168.1.1'"
    },
    {
      "id": "ping",
      "kind": "action",
      "title": "Test",
      "instruction": "Ping the gateway.",
      "expect": {
        "intent": "Type",
        "target": "ws"
      },
      "focus": "ws",
      "points": 10,
      "hints": [],
      "until": "ws.lastCommand == 'ping 192.168.1.1'"
    },
    {
      "id": "hosts",
      "kind": "measure",
      "title": "Calculate",
      "instruction": "How many USABLE host addresses are in a /24 network?",
      "record": {
        "key": "hosts",
        "label": "Usable hosts",
        "unit": "hosts",
        "truth": "254",
        "tolerance": 0
      },
      "points": 10,
      "hints": [
        "A /24 has 256 addresses.",
        "Subtract the network address and the broadcast address."
      ]
    },
    {
      "id": "q1",
      "kind": "checkpoint",
      "title": "Check your understanding",
      "instruction": "Answer the question.",
      "checkpoint": {
        "question": {
          "prompt": "What is the default gateway for?",
          "choices": [
            "Sending traffic to other networks (e.g. the internet)",
            "Storing files",
            "Naming the PC",
            "Printing"
          ],
          "answerIndex": 0,
          "explanation": "The gateway (router) forwards packets that leave the local network."
        }
      },
      "points": 10,
      "hints": []
    }
  ],
  "hazards": [],
  "results": [
    {
      "key": "hosts",
      "label": "Usable hosts",
      "unit": "",
      "expected": 254,
      "tolerancePct": 1,
      "source": "record.hosts"
    }
  ],
  "scoring": {
    "accuracy": 40,
    "procedure": 40,
    "safety": 20
  },
  "passScore": 60,
  "xp": 100
}
