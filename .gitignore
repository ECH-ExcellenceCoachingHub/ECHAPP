
# Firebase tools executable
frontend/firebase-tools-instant-win.exe
frontend/firebase_cpp_sdk_windows_12.7.0_fresh.zip

# Environment variables - NEVER commit secrets
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Visual Studio cache (contains a full-text index of the repo)
.vs/

# Firebase Admin credentials in any encoding
**/serviceAccountKey*
**/*firebase-adminsdk*.json

# Unity Android build output (regenerated on every Unity build; files exceed GitHub limits)
frontend/android/unityLibrary/build/

# Local logs and one-off debug scripts (keep them out of git)
*.log
/scratch/
/bfg.jar
