# ECH media worker: figure extraction (Python + PyMuPDF) and lesson video
# generation (Puppeteer/Chromium + KaTeX + FFmpeg + espeak-ng).
# Deployed as a Render Background Worker (see ../render.yaml). It never serves
# HTTP traffic, so CPU-heavy work stays away from the API service.
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    PYTHON_BIN=/opt/venv/bin/python \
    NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-dejavu-core fonts-noto-core fonts-noto-color-emoji \
      ffmpeg espeak-ng python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python dependencies for the figure extractor
COPY python/requirements.txt python/requirements.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r python/requirements.txt

# Node dependencies (production only)
COPY package*.json ./
COPY src/dataconnect-admin-generated src/dataconnect-admin-generated
RUN npm ci --omit=dev

COPY . .

# Run as an unprivileged user
RUN useradd --create-home worker && chown -R worker /app
USER worker

CMD ["node", "--max-old-space-size=768", "src/workers/media.worker.js"]
