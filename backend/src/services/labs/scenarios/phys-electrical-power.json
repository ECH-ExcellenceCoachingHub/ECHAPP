{
  "version": 1,
  "level": "secondary",
  "id": "phys-electrical-power",
  "title": "Electrical Power: P = V × I",
  "difficulty": 3,
  "durationMin": 15,
  "xp": 120,
  "summary": "Build a circuit, measure the voltage across a resistor and the current through it, then calculate the power it turns into heat.",
  "subject": "physics",
  "environment": "PhysicsLab",
  "tags": [
    "power",
    "circuits",
    "practice"
  ],
  "objectives": [
    "Measure voltage and current in a circuit",
    "Calculate electrical power with P = VI",
    "Relate power to heating"
  ],
  "equipment": [
    {
      "id": "psu",
      "type": "power_supply",
      "slot": "benchA.left",
      "init": {
        "maxVoltage": 12
      }
    },
    {
      "id": "board",
      "type": "breadboard",
      "slot": "benchA.center"
    },
    {
      "id": "r1",
      "type": "resistor",
      "slot": "benchB.left",
      "label": "Resistor R",
      "init": {
        "ohms": 47
      }
    },
    {
      "id": "amm",
      "type": "ammeter",
      "slot": "benchB.center"
    },
    {
      "id": "volt",
      "type": "voltmeter",
      "slot": "benchB.right"
    }
  ],
  "variables": {
    "circ": {
      "model": "phys.circuit",
      "inputs": {
        "circuit": "board"
      },
      "params": {
        "internalOhm": 0
      }
    }
  },
  "steps": [
    {
      "id": "place",
      "kind": "action",
      "title": "Build the circuit",
      "instruction": "Connect the resistor to the circuit board.",
      "expect": {
        "intent": "Connect",
        "target": "r1",
        "into": "board"
      },
      "focus": "r1",
      "points": 10,
      "hints": [],
      "until": "r1.connected"
    },
    {
      "id": "ammeter",
      "kind": "action",
      "title": "Build the circuit",
      "instruction": "Connect the ammeter in series.",
      "expect": {
        "intent": "Connect",
        "target": "amm",
        "into": "board"
      },
      "focus": "amm",
      "points": 10,
      "hints": [
        "Series means in the same loop as the resistor."
      ],
      "until": "amm.connected"
    },
    {
      "id": "voltmeter",
      "kind": "action",
      "title": "Build the circuit",
      "instruction": "Connect the voltmeter in parallel across the resistor.",
      "expect": {
        "intent": "Connect",
        "target": "volt",
        "into": "board"
      },
      "focus": "volt",
      "points": 10,
      "hints": [],
      "until": "volt.connected"
    },
    {
      "id": "power",
      "kind": "action",
      "title": "Power on",
      "instruction": "Switch on the power supply.",
      "expect": {
        "intent": "Toggle",
        "target": "psu"
      },
      "focus": "psu",
      "points": 5,
      "hints": [],
      "until": "psu.on"
    },
    {
      "id": "setv",
      "kind": "action",
      "title": "Set the voltage",
      "instruction": "Turn the voltage knob to 6.0 V.",
      "expect": {
        "intent": "Rotate",
        "target": "psu",
        "value": {
          "min": 5.9,
          "max": 6.1
        }
      },
      "focus": "psu",
      "points": 10,
      "hints": [],
      "until": "between(psu.voltageV, 5.9, 6.1)"
    },
    {
      "id": "readV",
      "kind": "measure",
      "title": "Take readings",
      "instruction": "Read the voltmeter.",
      "record": {
        "unit": "V",
        "key": "voltage",
        "label": "Voltage V",
        "truth": "volt.reading",
        "tolerance": 0.05
      },
      "points": 10,
      "hints": [],
      "focus": "volt"
    },
    {
      "id": "readI",
      "kind": "measure",
      "title": "Take readings",
      "instruction": "Read the ammeter.",
      "record": {
        "unit": "A",
        "key": "current",
        "label": "Current I",
        "truth": "amm.reading",
        "tolerance": 0.003
      },
      "points": 10,
      "hints": [],
      "focus": "amm"
    },
    {
      "id": "calcP",
      "kind": "measure",
      "title": "Calculate",
      "instruction": "Calculate the power P = V × I.",
      "record": {
        "unit": "W",
        "key": "power",
        "label": "Power P",
        "truth": "record.voltage * record.current",
        "tolerance": 0.02
      },
      "points": 15,
      "hints": [
        "Multiply your two readings. Give 2 decimal places."
      ]
    },
    {
      "id": "q1",
      "kind": "checkpoint",
      "title": "Check your understanding",
      "instruction": "Answer the question.",
      "checkpoint": {
        "question": {
          "prompt": "If you used a resistor with HALF the resistance at the same voltage, the power would…",
          "choices": [
            "Double",
            "Halve",
            "Stay the same",
            "Quadruple"
          ],
          "answerIndex": 0,
          "explanation": "P = V²/R — halving R at the same V doubles the power."
        }
      },
      "points": 10,
      "hints": []
    }
  ],
  "hazards": [
    {
      "id": "short",
      "when": "board.shortCircuit",
      "message": "Short circuit! The ammeter must be in series with the resistor. Switch off and reconnect.",
      "severity": "warn",
      "penalty": 15
    }
  ],
  "results": [
    {
      "key": "power",
      "label": "Power",
      "unit": "W",
      "expected": 0.766,
      "expectedExpr": "36 / r1.ohms",
      "tolerancePct": 4,
      "source": "record.power"
    }
  ],
  "scoring": {
    "accuracy": 40,
    "procedure": 45,
    "safety": 15
  },
  "randomize": [
    {
      "path": "r1.ohms",
      "choices": [
        22,
        33,
        47,
        68,
        100
      ]
    }
  ]
}
