{
  "version": 1,
  "level": "secondary",
  "id": "phys-timing-practice",
  "title": "Timing Practice: One Swing vs Ten",
  "difficulty": 2,
  "durationMin": 10,
  "xp": 90,
  "summary": "Learn why scientists time many swings: measure the period of a pendulum by timing 10 swings and dividing.",
  "subject": "physics",
  "environment": "PhysicsLab",
  "tags": [
    "measurement",
    "pendulum",
    "practice"
  ],
  "objectives": [
    "Use a stopwatch accurately",
    "Reduce timing error by timing many swings",
    "Calculate a period"
  ],
  "equipment": [
    {
      "id": "pend",
      "type": "pendulum",
      "slot": "benchA.center",
      "init": {
        "lengthM": 0.6,
        "massKg": 0.05
      }
    },
    {
      "id": "watch",
      "type": "stopwatch",
      "slot": "benchB.center"
    },
    {
      "id": "rule",
      "type": "metre_rule",
      "slot": "benchA.right"
    }
  ],
  "variables": {
    "pm": {
      "model": "phys.pendulum",
      "inputs": {
        "pendulum": "pend"
      }
    }
  },
  "steps": [
    {
      "id": "intro",
      "kind": "info",
      "title": "Why ten swings?",
      "instruction": "Your reaction time is about 0.2 s. Timing 10 swings and dividing by 10 makes that error 10 times smaller.",
      "points": 5,
      "hints": [],
      "say": "Timing many swings is a trick every scientist uses."
    },
    {
      "id": "release",
      "kind": "action",
      "title": "Start the swing",
      "instruction": "Pull the bob aside by a small angle (under 10°) and release it.",
      "expect": {
        "intent": "Release",
        "target": "pend"
      },
      "focus": "pend",
      "points": 10,
      "hints": [
        "Choose about 6–8°."
      ],
      "until": "pend.swinging && pend.amplitudeDeg <= 10"
    },
    {
      "id": "time10",
      "kind": "action",
      "title": "Time 10 swings",
      "instruction": "Start the stopwatch as the bob passes the centre, and stop it after 10 complete swings.",
      "expect": {
        "intent": "Toggle",
        "target": "watch"
      },
      "focus": "pend",
      "points": 20,
      "hints": [
        "One swing = there AND back to where it started."
      ],
      "until": "pend.oscillations >= 10 && !watch.running"
    },
    {
      "id": "time",
      "kind": "measure",
      "title": "Record",
      "instruction": "Record the stopwatch time.",
      "record": {
        "unit": "s",
        "key": "time",
        "label": "Time for 10 swings",
        "truth": "watch.elapsedS",
        "tolerance": 0.05
      },
      "points": 10,
      "hints": [],
      "focus": "watch"
    },
    {
      "id": "period",
      "kind": "measure",
      "title": "Calculate",
      "instruction": "Calculate the period T = time ÷ 10.",
      "record": {
        "unit": "s",
        "key": "period",
        "label": "Period T",
        "truth": "record.time / 10",
        "tolerance": 0.01
      },
      "points": 10,
      "hints": [
        "Divide by 10 — move the decimal point one place left."
      ]
    },
    {
      "id": "q1",
      "kind": "checkpoint",
      "title": "Check your understanding",
      "instruction": "Answer the question.",
      "checkpoint": {
        "question": {
          "prompt": "Why time 10 swings instead of 1?",
          "choices": [
            "It makes reaction-time error smaller",
            "The pendulum speeds up",
            "Stopwatches cannot time 1 swing",
            "It changes the period"
          ],
          "answerIndex": 0,
          "explanation": "The reaction-time error is shared over 10 swings, so the error per swing is 10× smaller."
        }
      },
      "points": 10,
      "hints": []
    }
  ],
  "hazards": [],
  "results": [
    {
      "key": "period",
      "label": "Period",
      "unit": "s",
      "expected": 1.554,
      "tolerancePct": 3,
      "source": "record.period"
    }
  ],
  "scoring": {
    "accuracy": 40,
    "procedure": 60,
    "safety": 0
  }
}
