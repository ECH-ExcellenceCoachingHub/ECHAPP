        "os": "Python 3",
        "commands": [
          "price = 1500",
          "qty = 4",
          "total = price * qty",
          "print(total)",
          "print(17 // 5)",
          "print(17 % 5)"
        ]
      }
    }
  ],
  "variables": {},
  "steps": [
    {
      "id": "v1",
      "kind": "action",
      "title": "Variables",
      "instruction": "Store the price of a notebook: price = 1500",
