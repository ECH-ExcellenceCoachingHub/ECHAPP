      "until": "ws.lastCommand == 'price = 1500'"
    },
    {
      "id": "v2",
      "kind": "action",
      "title": "Variables",
      "instruction": "Store the quantity: qty = 4",
      "expect": {
        "intent": "Type",
        "target": "ws"
      },
      "focus": "ws",
      "points": 10,
      "hints": [],
      "until": "ws.lastCommand == 'qty = 4'"
    },
    {
      "id": "v3",
      "kind": "action",
      "title": "Calculate",
      "instruction": "Work out the total.",
      "expect": {
        "intent": "Type",
        "target": "ws"
      },
      "focus": "ws",
      "points": 10,
      "hints": [],
