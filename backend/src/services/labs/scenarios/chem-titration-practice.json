{
  "version": 1,
  "level": "secondary",
  "id": "chem-titration-practice",
  "title": "Titration Practice: Nitric Acid",
  "difficulty": 2,
  "durationMin": 18,
  "xp": 110,
  "summary": "Extra titration practice with plenty of hints: neutralise nitric acid with potassium hydroxide and find the titre.",
  "subject": "chemistry",
  "environment": "ChemLab",
  "tags": [
    "titration",
    "practice"
  ],
  "objectives": [
    "Fill and read a burette",
    "Find an end point with phenolphthalein",
    "Calculate a titre"
  ],
  "equipment": [
    {
      "id": "goggles1",
      "type": "goggles",
      "slot": "ppe.rack"
    },
    {
      "id": "coat1",
      "type": "labcoat",
      "slot": "ppe.rack"
    },
    {
      "id": "alkali",
      "type": "reagent_bottle",
      "slot": "shelf.1",
      "label": "KOH 0.1 M",
      "init": {
        "solution": "KOH",
        "conc": 0.1,
        "volume": 500
      }
    },
    {
      "id": "ind",
      "type": "indicator",
      "slot": "shelf.2",
      "label": "Phenolphthalein",
      "init": {
        "name": "phenolphthalein"
      }
    },
    {
      "id": "burette1",
      "type": "burette",
      "slot": "benchA.center",
      "init": {
        "solution": "KOH",
        "conc": 0.1,
        "volume": 50
      }
    },
    {
      "id": "funnel1",
      "type": "funnel",
      "slot": "benchA.right"
    },
    {
      "id": "tile1",
      "type": "white_tile",
      "slot": "benchB.center"
    },
    {
      "id": "flask1",
      "type": "conical_flask",
      "slot": "benchB.left",
      "label": "Nitric acid",
      "init": {
        "solution": "HNO3",
        "conc": 0.1,
        "volume": 25
      }
    }
  ],
  "variables": {
    "titr": {
      "model": "chem.titration",
      "inputs": {
        "flask": "flask1",
        "burette": "burette1"
      },
      "params": {
        "indicator": "phenolphthalein"
      }
    }
  },
  "steps": [
    {
      "id": "ppe1",
      "kind": "action",
      "title": "Safety first",
      "instruction": "Put on your safety goggles.",
      "expect": {
        "intent": "Grab",
        "target": "goggles1"
      },
      "focus": "goggles1",
      "points": 5,
      "hints": []
    },
    {
      "id": "ppe2",
      "kind": "action",
      "title": "Safety first",
      "instruction": "Put on your lab coat.",
      "expect": {
        "intent": "Grab",
        "target": "coat1"
      },
      "focus": "coat1",
      "points": 5,
      "hints": []
    },
    {
      "id": "funnel",
      "kind": "action",
      "title": "Set up",
      "instruction": "Place the funnel in the top of the burette.",
      "expect": {
        "intent": "Grab",
        "target": "funnel1"
      },
      "focus": "funnel1",
      "points": 5,
      "hints": []
    },
    {
      "id": "rinse",
      "kind": "action",
      "title": "Rinse the burette",
      "instruction": "Rinse the burette with a little of the alkali (it drains to waste).",
      "expect": {
        "intent": "Pour",
        "target": "alkali",
        "into": "burette1"
      },
      "focus": "alkali",
      "points": 5,
      "hints": [
        "Rinsing with the solution itself stops water diluting it."
      ],
      "until": "burette1.rinsed"
    },
    {
      "id": "fill",
      "kind": "action",
      "title": "Fill the burette",
      "instruction": "Fill the burette with the alkali to about the 0.00 cm³ mark.",
      "expect": {
        "intent": "Pour",
        "target": "alkali",
        "into": "burette1"
      },
      "focus": "alkali",
      "points": 10,
      "hints": [
        "Select the bottle, Pour, then choose the burette."
      ],
      "until": "burette1.filled && burette1.volumeMl >= 49"
    },
    {
      "id": "read0",
      "kind": "measure",
      "title": "Initial reading",
      "instruction": "Read the burette at the bottom of the meniscus and record it.",
      "record": {
        "unit": "cm³",
        "key": "initialReading",
        "label": "Initial burette reading",
        "truth": "burette1.reading",
        "tolerance": 0.05
      },
      "points": 10,
      "hints": [
        "Read at eye level, to 2 decimal places."
      ],
      "focus": "burette1"
    },
    {
      "id": "indicator",
      "kind": "action",
      "title": "Add the indicator",
      "instruction": "Add 2–3 drops of phenolphthalein to the acid in the conical flask.",
      "expect": {
        "intent": "Pour",
        "target": "ind",
        "into": "flask1"
      },
      "focus": "ind",
      "points": 10,
      "hints": [],
      "until": "flask1.hasIndicator"
    },
    {
      "id": "tile",
      "kind": "action",
      "title": "Set up",
      "instruction": "Place the conical flask on the white tile under the burette.",
      "expect": {
        "intent": "Grab",
        "target": "flask1",
        "into": "tile1"
      },
      "focus": "flask1",
      "points": 5,
      "hints": []
    },
    {
      "id": "titrate",
      "kind": "action",
      "title": "Titrate",
      "instruction": "Open the tap and add alkali while swirling. Slow to single drops and stop when the solution turns pale pink.",
      "expect": {
        "intent": "Rotate",
        "target": "burette1"
      },
      "focus": "burette1",
      "points": 20,
      "hints": [
        "Near the end point the colour lingers longer — go drop by drop."
      ],
      "until": "titr.colorIndex >= 0.35"
    },
    {
      "id": "read1",
      "kind": "measure",
      "title": "Final reading",
      "instruction": "Read and record the final burette reading.",
      "record": {
        "unit": "cm³",
        "key": "finalReading",
        "label": "Final burette reading",
        "truth": "burette1.reading",
        "tolerance": 0.05
      },
      "points": 10,
      "hints": [],
      "focus": "burette1"
    },
    {
      "id": "titre",
      "kind": "measure",
      "title": "Calculate",
      "instruction": "Calculate the titre: final reading − initial reading.",
      "record": {
        "unit": "cm³",
        "key": "titre",
        "label": "Titre",
        "truth": "record.finalReading - record.initialReading",
        "tolerance": 0.05
      },
      "points": 10,
      "hints": [
        "Subtract the first reading from the second."
      ]
    },
    {
      "id": "q1",
      "kind": "checkpoint",
      "title": "Check your understanding",
      "instruction": "Answer the question.",
      "checkpoint": {
        "question": {
          "prompt": "Why do we put the flask on a white tile?",
          "choices": [
            "To see the colour change clearly",
            "To keep it warm",
            "To stop the reaction",
            "To measure its mass"
          ],
          "answerIndex": 0,
          "explanation": "A white background makes the first faint pink easy to see."
        }
      },
      "points": 10,
      "hints": []
    }
  ],
  "hazards": [
    {
      "id": "noGoggles",
      "when": "!goggles1.worn && (burette1.volumeMl > 0 || alkali.poured)",
      "message": "Stop! You are handling alkali without goggles.",
      "severity": "warn",
      "penalty": 15
    },
    {
      "id": "overshoot",
      "when": "titr.pH > 11.5",
      "message": "You overshot the end point. A real chemist would repeat the titration.",
      "severity": "warn",
      "penalty": 10
    }
  ],
  "results": [
    {
      "key": "titre",
      "label": "Titre",
      "unit": "cm³",
      "expected": 25,
      "expectedExpr": "flask1.conc * 25 / 0.1",
      "tolerancePct": 2,
      "source": "record.titre"
    }
  ],
  "scoring": {
    "accuracy": 40,
    "procedure": 40,
    "safety": 20
  },
  "randomize": [
    {
      "path": "flask1.conc",
      "min": 0.06,
      "max": 0.14,
      "decimals": 3
    }
  ]
}
